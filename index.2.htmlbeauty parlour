<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Glow & Grace Beauty Studio | Bhubaneswar</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,460;0,9..144,560;0,9..144,650;1,9..144,460&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

:root{
    --ivory:#FBF6EE;
    --paper:#FFFEFB;
    --maroon:#6E1F2B;
    --maroon-dark:#4C131C;
    --gold:#B9862E;
    --gold-light:#E7C88A;
    --blush:#F3DCD3;
    --ink:#2B211E;
    --muted:#7C6E66;
    --shadow:0 18px 40px -20px rgba(78,22,29,0.35);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--ivory);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:400;
    line-height:1.6;
}

h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:560;
    letter-spacing:-0.01em;
    color:var(--maroon-dark);
}

img{
    display:block;
    max-width:100%;
}

a{
    color:inherit;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-size:12.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--gold);
    font-weight:500;
    margin-bottom:14px;
}

.eyebrow::before{
    content:"";
    width:26px;
    height:1px;
    background:var(--gold);
}

.wrap{
    max-width:1180px;
    margin:0 auto;
    padding:0 6%;
}

/* IKAT DIVIDER */

.ikat{
    height:14px;
    width:100%;
    background-image:linear-gradient(135deg, var(--gold) 25%, transparent 25%),
                      linear-gradient(225deg, var(--gold) 25%, transparent 25%),
                      linear-gradient(45deg, var(--gold) 25%, transparent 25%),
                      linear-gradient(315deg, var(--gold) 25%, transparent 25%);
    background-position:14px 0, 14px 0, 0 0, 0 0;
    background-size:14px 14px;
    background-repeat:repeat-x;
    opacity:0.85;
}

/* NAVBAR */

nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 6%;
    background:
        linear-gradient(rgba(251,246,238,0.93), rgba(251,246,238,0.93)),
        url("https://images.unsplash.com/photo-1470259078422-826894b933aa?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(185,134,46,0.25);
    position:sticky;
    top:0;
    z-index:1000;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:'Fraunces', serif;
    font-size:22px;
    font-weight:560;
    color:var(--maroon);
}

.logo svg{
    width:30px;
    height:30px;
}

.nav-links{
    display:flex;
    align-items:center;
    list-style:none;
    gap:30px;
}

.nav-links a{
    text-decoration:none;
    color:var(--ink);
    font-size:15px;
    font-weight:400;
    position:relative;
    padding-bottom:4px;
}

.nav-links a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:0;
    width:0;
    height:1px;
    background:var(--maroon);
    transition:width 0.25s ease;
}

.nav-links a:hover::after{
    width:100%;
}

.nav-cta{
    background:var(--maroon);
    color:var(--paper) !important;
    padding:11px 22px;
    border-radius:2px;
    font-size:14px !important;
}

.nav-cta::after{
    display:none;
}

.nav-toggle{
    display:none;
    background:none;
    border:none;
    cursor:pointer;
    padding:6px;
}

.nav-toggle span{
    display:block;
    width:24px;
    height:1.5px;
    background:var(--maroon-dark);
    margin:5px 0;
}

/* HERO */

.hero{
    padding:80px 6% 70px;
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:60px;
    align-items:center;
    max-width:1180px;
    margin:0 auto;
}

.hero h1{
    font-size:clamp(38px, 5vw, 60px);
    line-height:1.06;
    margin-bottom:22px;
}

.hero h1 em{
    font-style:italic;
    color:var(--maroon);
}

.hero p{
    font-size:17.5px;
    color:var(--muted);
    max-width:440px;
    margin-bottom:34px;
}

.hero-actions{
    display:flex;
    align-items:center;
    gap:26px;
    flex-wrap:wrap;
    margin-bottom:44px;
}

.btn{
    display:inline-block;
    background:var(--maroon);
    color:var(--paper);
    padding:15px 30px;
    border-radius:2px;
    text-decoration:none;
    font-size:14.5px;
    letter-spacing:0.02em;
    border:1px solid var(--maroon);
    transition:0.25s;
}

.btn:hover{
    background:var(--maroon-dark);
    border-color:var(--maroon-dark);
}

.btn-outline{
    background:transparent;
    color:var(--maroon);
}

.btn-outline:hover{
    background:var(--maroon);
    color:var(--paper);
}

.link-cta{
    text-decoration:none;
    font-size:14.5px;
    color:var(--ink);
    border-bottom:1px solid var(--gold);
    padding-bottom:2px;
}

.hero-stats{
    display:flex;
    gap:40px;
}

.hero-stats div strong{
    display:block;
    font-family:'Fraunces', serif;
    font-size:26px;
    color:var(--maroon-dark);
}

.hero-stats div span{
    font-size:12.5px;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:0.08em;
}

.hero-visual{
    position:relative;
}

.arch-ring{
    position:absolute;
    top:-26px;
    left:-26px;
    right:26px;
    bottom:26px;
    border:1.5px solid var(--gold);
    border-radius:220px 220px 0 0;
    z-index:0;
}

.arch-photo{
    position:relative;
    z-index:1;
    aspect-ratio:3/4;
    overflow:hidden;
    border-radius:220px 220px 0 0;
    box-shadow:var(--shadow);
}

.arch-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.float-card{
    position:absolute;
    bottom:26px;
    left:-30px;
    z-index:2;
    background:var(--paper);
    padding:16px 22px;
    border-radius:2px;
    box-shadow:var(--shadow);
    border-left:3px solid var(--gold);
}

.float-card strong{
    display:block;
    font-family:'Fraunces', serif;
    font-size:19px;
    color:var(--maroon-dark);
}

.float-card span{
    font-size:12.5px;
    color:var(--muted);
}

/* SECTIONS */

section{
    padding:90px 6%;
}

.section-inner{
    max-width:1180px;
    margin:0 auto;
}

.title{
    max-width:560px;
    margin-bottom:56px;
}

.title.center{
    margin-left:auto;
    margin-right:auto;
    text-align:center;
}

.title h2{
    font-size:clamp(30px, 3.6vw, 42px);
    margin-bottom:14px;
}

.title p{
    color:var(--muted);
    font-size:16.5px;
}

/* SERVICES */

.services{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:28px;
}

.service-card{
    background:var(--paper);
    padding:0;
    text-align:left;
    border:1px solid rgba(185,134,46,0.2);
    border-radius:120px 120px 4px 4px;
    overflow:hidden;
    transition:0.3s;
}

.service-card:hover{
    transform:translateY(-6px);
    border-color:var(--gold);
    box-shadow:var(--shadow);
}

.service-card-inner{
    padding:44px 28px 30px;
}

.service-icon{
    width:56px;
    height:56px;
    border-radius:50%;
    background:var(--blush);
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 22px;
}

.service-icon svg{
    width:26px;
    height:26px;
    stroke:var(--maroon);
}

.service-card h3{
    text-align:center;
    margin-bottom:10px;
    font-size:20px;
}

.service-card p{
    text-align:center;
    color:var(--muted);
    font-size:14.5px;
}

/* ABOUT */

.about{
    background:var(--paper);
    border-top:1px solid rgba(185,134,46,0.2);
    border-bottom:1px solid rgba(185,134,46,0.2);
}

.about-container{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:64px;
    align-items:center;
}

.about-photo{
    position:relative;
}

.about-photo::before{
    content:"";
    position:absolute;
    top:-20px;
    right:-20px;
    bottom:20px;
    left:20px;
    border:1.5px solid var(--gold-light);
    border-radius:4px 4px 4px 140px;
    z-index:0;
}

.about-photo img{
    position:relative;
    z-index:1;
    border-radius:4px 4px 4px 140px;
    aspect-ratio:4/5;
    object-fit:cover;
    box-shadow:var(--shadow);
}

.about-text h2{
    font-size:clamp(28px, 3.4vw, 38px);
    margin-bottom:20px;
}

.about-text p{
    line-height:1.85;
    margin-bottom:16px;
    color:var(--muted);
    font-size:16px;
}

.about-highlights{
    list-style:none;
    margin:26px 0 32px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.about-highlights li{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:14.5px;
    color:var(--ink);
}

.about-highlights svg{
    width:16px;
    height:16px;
    stroke:var(--gold);
    flex-shrink:0;
}

/* PACKAGES */

.packages{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:26px;
}

.package{
    background:var(--paper);
    padding:40px 30px;
    border-radius:4px;
    text-align:left;
    border:1px solid rgba(185,134,46,0.2);
    position:relative;
}

.package.featured{
    background:var(--maroon);
    color:var(--blush);
    border-color:var(--maroon);
    transform:translateY(-10px);
}

.package-tag{
    position:absolute;
    top:-13px;
    right:26px;
    background:var(--gold);
    color:var(--maroon-dark);
    font-size:11.5px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    padding:6px 14px;
    border-radius:20px;
    font-weight:500;
}

.package h3{
    color:var(--maroon-dark);
    font-size:22px;
    margin-bottom:6px;
}

.package.featured h3{
    color:var(--paper);
}

.package .sub{
    font-size:13px;
    color:var(--muted);
    margin-bottom:20px;
}

.package.featured .sub{
    color:var(--gold-light);
}

.price{
    font-family:'Fraunces', serif;
    font-size:38px;
    color:var(--maroon-dark);
    margin-bottom:22px;
}

.package.featured .price{
    color:var(--paper);
}

.package ul{
    list-style:none;
    margin-bottom:30px;
}

.package ul li{
    padding:9px 0;
    color:var(--muted);
    font-size:14.5px;
    border-top:1px solid rgba(185,134,46,0.15);
}

.package.featured ul li{
    color:var(--blush);
    border-top:1px solid rgba(255,255,255,0.15);
}

.package ul li:first-child{
    border-top:none;
}

.package .btn{
    width:100%;
    text-align:center;
}

.package.featured .btn{
    background:var(--gold);
    border-color:var(--gold);
    color:var(--maroon-dark);
}

.package.featured .btn:hover{
    background:var(--gold-light);
    border-color:var(--gold-light);
}

/* GALLERY */

.gallery{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:22px;
}

.gallery-item{
    overflow:hidden;
    border-radius:150px 150px 4px 4px;
    box-shadow:var(--shadow);
}

.gallery-item:nth-child(2){
    margin-top:40px;
}

.gallery-item img{
    width:100%;
    height:320px;
    object-fit:cover;
    transition:0.4s;
}

.gallery-item:hover img{
    transform:scale(1.06);
}

/* BOOKING */

.booking{
    background:var(--maroon);
}

.booking-grid{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    background:var(--paper);
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 30px 60px -25px rgba(0,0,0,0.4);
}

.booking-info{
    background:var(--maroon-dark);
    color:var(--blush);
    padding:50px 40px;
    position:relative;
    overflow:hidden;
}

.booking-info::after{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    border:1px solid rgba(231,200,138,0.25);
    border-radius:50%;
    top:-90px;
    right:-90px;
}

.booking-info h3{
    color:var(--paper);
    font-size:26px;
    margin-bottom:16px;
    position:relative;
}

.booking-info p{
    color:var(--gold-light);
    font-size:14.5px;
    line-height:1.8;
    margin-bottom:30px;
    position:relative;
}

.booking-contact{
    display:flex;
    flex-direction:column;
    gap:16px;
    position:relative;
}

.booking-contact div{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:14.5px;
}

.booking-contact svg{
    width:18px;
    height:18px;
    stroke:var(--gold-light);
    flex-shrink:0;
}

.booking-form{
    padding:50px 40px;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.booking-form label{
    font-size:12.5px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--muted);
    display:block;
    margin-bottom:6px;
}

.field{
    margin-bottom:18px;
}

.booking-form input,
.booking-form select,
.booking-form textarea{
    width:100%;
    padding:13px 14px;
    border:1px solid rgba(185,134,46,0.35);
    border-radius:2px;
    font-family:'Jost', sans-serif;
    font-size:14.5px;
    background:var(--ivory);
    color:var(--ink);
}

.booking-form input:focus,
.booking-form select:focus,
.booking-form textarea:focus{
    outline:none;
    border-color:var(--maroon);
}

.booking-form button{
    width:100%;
    border:none;
    cursor:pointer;
    font-size:15px;
    margin-top:8px;
}

/* CONTACT */

.contact-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:24px;
}

.contact-card{
    background:var(--paper);
    border:1px solid rgba(185,134,46,0.2);
    border-radius:4px;
    padding:32px 26px;
    text-align:center;
}

.contact-card svg{
    width:26px;
    height:26px;
    stroke:var(--maroon);
    margin-bottom:16px;
}

.contact-card h4{
    font-family:'Fraunces', serif;
    color:var(--maroon-dark);
    font-size:17px;
    margin-bottom:6px;
    font-weight:560;
}

.contact-card p{
    color:var(--muted);
    font-size:14.5px;
}

/* WHATSAPP */

.whatsapp{
    position:fixed;
    bottom:26px;
    right:26px;
    background:var(--maroon);
    color:white;
    width:56px;
    height:56px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    box-shadow:0 10px 24px -6px rgba(78,22,29,0.55);
    z-index:900;
}

.whatsapp svg{
    width:26px;
    height:26px;
    stroke:white;
}

/* FOOTER */

footer{
    background:var(--maroon-dark);
    color:var(--gold-light);
    text-align:center;
    padding:36px 6% 30px;
    font-size:13.5px;
}

footer .logo{
    justify-content:center;
    color:var(--paper);
    margin-bottom:14px;
}

/* MOBILE */

@media(max-width:900px){

    .hero{
        grid-template-columns:1fr;
    }

    .hero-visual{
        order:-1;
        max-width:340px;
        margin:0 auto;
    }

    .about-container{
        grid-template-columns:1fr;
    }

    .about-photo{
        max-width:340px;
        margin:0 auto;
    }

    .booking-grid{
        grid-template-columns:1fr;
    }

    .gallery{
        grid-template-columns:1fr 1fr;
    }

    .gallery-item:nth-child(2){
        margin-top:0;
    }
}

@media(max-width:768px){

    .nav-links{
        position:fixed;
        top:73px;
        left:0;
        right:0;
        background:var(--ivory);
        flex-direction:column;
        align-items:flex-start;
        padding:24px 6% 30px;
        border-bottom:1px solid rgba(185,134,46,0.25);
        gap:18px;
        display:none;
    }

    .nav-links.open{
        display:flex;
    }

    .nav-toggle{
        display:block;
    }

    section{
        padding:64px 6%;
    }

    .hero{
        padding:50px 6% 50px;
    }

    .hero-stats{
        gap:26px;
    }

    .form-row{
        grid-template-columns:1fr;
    }

    .gallery{
        grid-template-columns:1fr;
    }

    .float-card{
        left:0;
        bottom:-18px;
    }
}

</style>

</head>

